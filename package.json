{
  "name": "organizeyourworkplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prebuild": "node scripts/cms-fetch.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "precheck": "node scripts/cms-fetch.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "predev": "node scripts/cms-fetch.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "cms:fetch": "node scripts/cms-fetch.mjs",
    "cms:fetch:mirror": "node scripts/cms-fetch.mjs --mirror data",
    "cms:export": "node scripts/cms-fetch.mjs --mirror data"
  },
  "dependencies": {
    "astro": "7.4.2",
    "astro-loader-pocketbase": "4.0.8",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.5",
    "fake-indexeddb": "6.2.6",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}

# Reference proxy config for the content site (H2–H4, U2, U0c, G3).
# Coolify's default proxy is Traefik (see traefik-dynamic.yml); this Caddyfile
# is the readable spec both configs must satisfy.

organizeyourworkplace.com {
	# H3: no access log directive = no access log. Do not add `log`.
	# (Caddy writes nothing unless configured; verify with the H3 grep test.)

	root * /srv/dist
	encode zstd gzip

	# The sync server, reached at the app's own origin. The app's CSP only
	# lets the page talk to itself, so the sync paths are proxied here:
	# /mailbox/ and /match/ on the site host reach the sync service, which
	# routes them itself. The sync server's own host still answers for
	# hosts that only want the API.
	handle /mailbox/* {
		reverse_proxy sync:8080
	}
	handle /match/* {
		reverse_proxy sync:8080
	}

	header {
		# H4 / 05-security.md §Web hardening
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The service worker for the workspace app. It has to be allowed to
	# cover /app/ and /es/app/, which are not its own directory.
	@appWorker path /app-sw.js
	header @appWorker Service-Worker-Allowed "/"

	# U2 + U0c: Umami under a first-party path, client IP replaced with a
	# fixed value before Umami sees it. No location data; pageview counts
	# per page and language stay accurate.
	handle /s/* {
		reverse_proxy umami:3000 {
			header_up X-Forwarded-For "0.0.0.0"
			header_up X-Real-IP "0.0.0.0"
		}
	}

	# G3: GlitchTip first-party tunnel. Strips IP, User-Agent detail,
	# cookies and referrer before forwarding.
	handle /e/* {
		reverse_proxy glitchtip:8000 {
			header_up X-Forwarded-For "0.0.0.0"
			header_up X-Real-IP "0.0.0.0"
			header_up User-Agent "oyw-tunnel"
			header_up Cookie ""
			header_up Referer ""
		}
	}

	handle {
		file_server
		try_files {path} /index.html
	}
}

# mbx (PocketBase mailbox) — the guard is the public door (P6–P11).
mbx.organizeyourworkplace.com {
	# H3: no access log.
	reverse_proxy mbx_guard:8080 {
		header_up X-Forwarded-For "0.0.0.0"
		header_up X-Real-IP "0.0.0.0"
	}

	# P10: no admin UI on the public subdomain.
	respond /_* 403
	respond /_ 403
}

# sig (matchmaker) — signaling only, memory only (05-security §Matchmaker).
sig.organizeyourworkplace.com {
	# H3: no access log.
	reverse_proxy sig:8090 {
		header_up X-Forwarded-For "0.0.0.0"
		header_up X-Real-IP "0.0.0.0"
	}
}
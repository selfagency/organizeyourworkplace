---
import Footer from '../components/Footer.astro';
import LeaveWarning from '../components/LeaveWarning.astro';
import Nav from '../components/Nav.astro';
import WorkDeviceBanner from '../components/WorkDeviceBanner.astro';
import { type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  lang?: Locale;
}

const { title, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <WorkDeviceBanner locale={lang} />
    <Nav locale={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={lang} />
    <LeaveWarning locale={lang} />
  </body>
</html>
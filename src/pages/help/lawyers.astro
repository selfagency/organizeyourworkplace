---
import Base from '../../layouts/Base.astro';
import { getHelpResources } from '../../data/load';
import { format, t } from '../../i18n';

const asOf = '2026-10-26';
const directories = getHelpResources().filter(
  (r) => r.type === 'lawyer_directory' || r.type === 'legal_aid',
);
const label: Record<string, string> = {
  lawyer_directory: 'Worker-side lawyer directory',
  legal_aid: 'Free legal aid',
};
---

<Base title={`${t('en', 'nav.help')}: lawyers · ${t('en', 'site.name')}`} lang="en">
  <div class="legal-notices">
    <p class="legal-stamp">
      <a href="/rights/whats-changed">
        {format(t('en', 'legal.statusAsOf'), { date: asOf })} · {t('en', 'legal.whatsChanged')}
      </a>
    </p>
    <p class="legal-nla">
      {t('en', 'legal.notLegalAdvice')}
    </p>
  </div>
  <article>
    <h1>Lawyers and legal help for workers</h1>
    <p><strong>This page is not legal advice. It's how to find someone who can give it.</strong></p>
    <h2>What this means for you</h2>
    <p>
      For most organizing problems, you don't start with a lawyer: the NLRB's own process is free (<a href="/help/file-a-charge">file a charge</a>). But some situations need counsel: an employer lawsuit, a complex termination, discrimination claims outside the NLRA, negotiating a severance.
    </p>
    <h2>What to do now</h2>
    <ol>
      <li>Check the free routes first: <a href="/file-a-charge">an NLRB charge</a>, <a href="/worker-centers">worker centers</a>, legal aid below.</li>
      <li>If you need a lawyer, use the directories below. Ask about fees before you commit, and get the fee agreement in writing.</li>
      <li>Union-side help: if you're in touch with a union organizer (see <a href="/unions/first-call">the first call</a>), ask what legal support they commit to their campaigns.</li>
    </ol>
    <h2>Directories</h2>
    <ul class="office-list">
      {directories.map((d) => (
        <li>
          <strong>{d.name}</strong> · {label[d.type] ?? d.type} · serves {d.area_served}{' '}
          <a href={d.contact} rel="noopener noreferrer">{d.contact.replace(/^https?:\/\//, '')}</a>
        </li>
      ))}
    </ul>
    <h2>Watch out</h2>
    <p>
      NELA's directory lists worker-side employment lawyers, but NELA itself makes no recommendations and its members aren't obligated to take your case. Interview more than one [A75]. Legal aid covers free help for low-income workers and is limited by capacity [A76]. For management-side lawyers: you'll meet them on the other side of the table, not in these directories.
    </p>
  </article>
</Base>

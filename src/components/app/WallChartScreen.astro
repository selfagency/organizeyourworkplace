---
import { appT } from '../../i18n/app';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
---

<h1>{appT(lang, 'app.wall.title')}</h1>

<div class="views" role="tablist" data-wall-views>
  <button class="views__tab" type="button" role="tab" aria-selected="true" data-view="grid">
    {appT(lang, 'app.wall.view.grid')}
  </button>
  <button class="views__tab" type="button" role="tab" aria-selected="false" data-view="explorer">
    {appT(lang, 'app.wall.view.explorer')}
  </button>
  <button class="views__tab" type="button" role="tab" aria-selected="false" data-view="trend">
    {appT(lang, 'app.wall.view.trend')}
  </button>
</div>

<div class="filters" data-wall-filters>
  <button class="filter" type="button" aria-pressed="false" data-filter="yes">
    {appT(lang, 'app.wall.filter.yes')}
  </button>
  <button class="filter" type="button" aria-pressed="false" data-filter="unassigned">
    {appT(lang, 'app.wall.filter.unassigned')}
  </button>
  <button class="filter" type="button" aria-pressed="false" data-filter="stale">
    {appT(lang, 'app.wall.filter.stale')}
  </button>
</div>

<div data-wall-body></div>

<form class="well" data-coworker-form>
  <h2>{appT(lang, 'app.wall.add')}</h2>
  <label class="field">
    <span class="field__label">{appT(lang, 'app.wall.name')}</span>
    <input class="field__input" type="text" name="displayName" required maxlength="40" />
    <span class="field__error" data-coworker-error hidden></span>
  </label>
  <label class="field">
    <span class="field__label">{appT(lang, 'app.wall.department')}</span>
    <input class="field__input" type="text" name="dept" maxlength="30" />
  </label>
  <label class="field">
    <span class="field__label">{appT(lang, 'app.wall.shift')}</span>
    <input class="field__input" type="text" name="shift" maxlength="30" />
  </label>
  <label class="field">
    <span class="field__label">{appT(lang, 'app.wall.language')}</span>
    <input class="field__input" type="text" name="language" maxlength="20" />
  </label>
  <button class="button button--primary button--block" type="submit" data-coworker-save>
    {appT(lang, 'app.wall.save')}
  </button>
</form>

<script>
  import '../../scripts/app/wall-chart';
</script>

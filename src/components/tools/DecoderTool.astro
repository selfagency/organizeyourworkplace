---
// T4 "Is that legal?" decoder UI. Local keyword match, no server.
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const S = {
  en: {
    title: 'Is that legal?',
    intro: 'Pick what happened — or type the words your boss used. Checked on your phone.',
    pick: 'Common ones:',
    or: 'or type it:',
    typePh: '"We might have to close." "Who\'s behind this?"',
    submit: 'Decode',
    restart: 'Clear',
    result: 'What it is',
    illegal: 'Probably illegal',
    misleading: 'Legal, but misleading',
    legal: 'Legal',
    illegalBody: 'That crosses a TIPS line — Threaten, Interrogate, Promise, Spy. Write down the date, time, exact words, and who was present. This is charge evidence.',
    misleadingBody: 'The law allows it, but the framing is the boss\'s advantage. Don\'t argue it alone — bring it to your committee and answer it together.',
    legalBody: 'Facts and opinions are legal. Your counter is your own facts — see the FOE page for how the pros answer.',
    rule: 'Rule',
    asOf: 'Status as of',
    log: 'Log it as evidence',
    dontLog: 'No need to log this one',
    reply: 'How to respond',
    replies: {
      'close-threat': 'Say calmly: "Please put that in writing." Then do write down what was said. Closure threats aimed at union activity are illegal — they feed a ULP charge.',
      interrogate: 'You may stay silent: "I\'d rather not discuss coworkers." Interrogation about union support is illegal — note who asked, who was there, and the exact words.',
      'promise-raise': 'Promises of benefits to reward rejecting the union are illegal. Write down the exact promise, the date, and who made it.',
      watching: 'Surveillance of union activity is illegal. Note what you saw, when, and who did it — badges, cameras aimed at meetings, people following you.',
      'captive-meeting': 'Mandatory anti-union meetings are still federally legal (state bans are in court). Go, stay calm, write down every threat and promise. A dozen states ban them — see the state laws page.',
      'third-party': 'Ask back: "Who\'s paying the consultant running this campaign?" The union is the workers in this building.',
      'we-are-family': '"Families don\'t cut hours by email." If it\'s a family, workers get a real say — that\'s the union.',
      'mid-campaign-raise': 'Write down the date, who announced it, and the exact words. Raises granted to buy a "no" vote are illegal; raises promised "if you vote no" even more so.',
      'foe-opinion': 'Opinions are legal — counter them with facts: contract wages in your industry, the fee schedule, what the law requires. See the FOE page.',
      'foe-facts': 'Their facts may be technically true and still misleading. Compare against real contracts and the union\'s actual dues schedule.',
    },
    repliesEsNote: '',
    fileCharge: 'Already punished? File a charge.',
    notAdvice: 'Not legal advice. This tool explains common patterns, not your specific case.',
  },
  es: {
    title: '¿Eso es legal?',
    intro: 'Elige lo que pasó — o escribe las palabras de tu jefe. Se revisa en tu teléfono.',
    pick: 'Los más comunes:',
    or: 'o escríbelo:',
    typePh: '"Puede que tengamos que cerrar." "¿Quién está detrás de esto?"',
    submit: 'Descifrar',
    restart: 'Borrar',
    result: 'Qué es',
    illegal: 'Probablemente ilegal',
    misleading: 'Legal, pero engañoso',
    legal: 'Legal',
    illegalBody: 'Cruza una línea TIPS — Amenazar, Interrogar, Prometer, Espiar. Anota la fecha, hora, palabras exactas y quién estaba presente. Esto es evidencia para un cargo.',
    misleadingBody: 'La ley lo permite, pero el encuadre favorece al jefe. No lo discutas solo — llévalo a tu comité y respóndanlo juntos.',
    legalBody: 'Los datos y las opiniones son legales. Tu contrapeso son tus propios datos — mira la página FOE para cómo se responde.',
    rule: 'Regla',
    asOf: 'Vigente al',
    log: 'Regístralo como evidencia',
    dontLog: 'Este no hace falta registrarlo',
    reply: 'Cómo responder',
    replies: {
      'close-threat': 'Di con calma: "Póngalo por escrito." Luego anota lo dicho. Las amenazas de cierre por actividad sindical son ilegales — alimentan un cargo ULP.',
      interrogate: 'Puedes callar: "Prefiero no hablar de compañeros." Interrogar sobre apoyo sindical es ilegal — anota quién preguntó, quién estaba y las palabras exactas.',
      'promise-raise': 'Prometer beneficios por rechazar el sindicato es ilegal. Anota la promesa exacta, la fecha y quién la hizo.',
      watching: 'Vigilar actividad sindical es ilegal. Anota qué viste, cuándo y quién — credenciales, cámaras en reuniones, gente siguiéndote.',
      'captive-meeting': 'Las reuniones antisindical obligatorias siguen siendo legales a nivel federal (las prohibiciones estatales están en los tribunales). Ve, mantén la calma y anota cada amenaza y promesa. Una docena de estados las prohíbe — mira las leyes estatales.',
      'third-party': 'Pregunta: "¿Quién paga al consultor de esta campaña?" El sindicato son los trabajadores de este edificio.',
      'we-are-family': '"Las familias no cortan horas por correo." Si somos familia, los trabajadores tenemos voz real — eso es el sindicato.',
      'mid-campaign-raise': 'Anota la fecha, quién lo anunció y las palabras exactas. Aumentos para comprar un voto "no" son ilegales; promesas "si votan no", más.',
      'foe-opinion': 'Las opiniones son legales — contrarresta con datos: sueldos de contratos de tu industria, la tabla de cuotas, lo que exige la ley. Mira la página FOE.',
      'foe-facts': 'Sus datos pueden ser técnicamente ciertos y aun así engañosos. Compara con contratos reales y el calendario real de cuotas del sindicato.',
    },
    fileCharge: '¿Ya te castigaron? Presenta un cargo.',
    notAdvice: 'No es asesoría legal. Esta herramienta explica patrones comunes, no tu caso concreto.',
  },
}[lang];
const prefix = lang === 'es' ? '/es' : '';
const seeded = [
  { id: 'close-threat', label: lang === 'es' ? '"Puede que cerremos"' : '"We might have to close"' },
  { id: 'interrogate', label: lang === 'es' ? '"¿Quién está detrás?"' : '"Who\'s behind this?"' },
  { id: 'promise-raise', label: lang === 'es' ? 'Aumento si votan no' : 'A raise if we vote no' },
  { id: 'captive-meeting', label: lang === 'es' ? 'Reunión obligatoria' : 'A mandatory meeting' },
  { id: 'third-party', label: lang === 'es' ? '"Son un tercero"' : '"They\'re a third party"' },
];
const chargeHref = lang === 'es' ? '/es/help/file-a-charge' : '/help/file-a-charge';
const stateHref = lang === 'es' ? '/es/rights/state-laws' : '/rights/state-laws';
---

<article class="tool" id="decoder" data-prefix={prefix}>
  <h1>{S.title}</h1>
  <p class="tool__intro">{S.intro}</p>
  <form id="decoder-form">
    <fieldset>
      <legend>{S.pick}</legend>
      {seeded.map((s) => (
        <label class="choice"><input type="radio" name="pick" value={s.id} /> {s.label}</label>
      ))}
    </fieldset>
    <label>{S.or}<input type="text" name="freetext" placeholder={S.typePh} autocomplete="off" /></label>
    <div class="tool__actions">
      <button type="submit">{S.submit}</button>
      <button type="button" id="decoder-clear" class="btn-secondary">{S.restart}</button>
    </div>
  </form>
  <section id="decoder-result" class="tool__result" hidden>
    <h2>{S.result}</h2>
    <p id="decoder-verdict" class="tool__primary"></p>
    <p id="decoder-body"></p>
    <h3>{S.reply}</h3>
    <p id="decoder-reply"></p>
    <p id="decoder-log" class="tool__warn"></p>
    <p class="tool__hint">{S.notAdvice} <a href={chargeHref}>{S.fileCharge}</a></p>
  </section>
</article>

<script>
  import { decode, pick, type Verdict } from '../../lib/tools/decoder';

  const root = document.getElementById('decoder');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('#decoder-form')!;
    const result = root.querySelector<HTMLElement>('#decoder-result')!;
    const verdictEl = root.querySelector<HTMLElement>('#decoder-verdict')!;
    const bodyEl = root.querySelector<HTMLElement>('#decoder-body')!;
    const replyEl = root.querySelector<HTMLElement>('#decoder-reply')!;
    const logEl = root.querySelector<HTMLElement>('#decoder-log')!;
    const dict = JSON.parse(root.querySelector('script[data-replies]')!.textContent!) as {
      verdicts: Record<Verdict, { title: string; body: string }>;
      replies: Record<string, string>;
      log: string;
      dontLog: string;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const pickId = String(d.get('pick') ?? '');
      const free = String(d.get('freetext') ?? '');
      const entry = pickId ? pick(pickId) : (free.trim() ? decode(free)?.entry ?? null : null);
      if (!entry) {
        replyEl.textContent = dict.dontLog;
        verdictEl.textContent = '';
        bodyEl.textContent = '';
        logEl.textContent = '';
        result.hidden = false;
        return;
      }
      const v = dict.verdicts[entry.verdict];
      verdictEl.textContent = v.title;
      bodyEl.textContent = v.body;
      replyEl.textContent = dict.replies[entry.replyKey] ?? '';
      logEl.textContent = entry.logEvidence ? dict.log : '';
      result.hidden = false;
    });

    root.querySelector('#decoder-clear')?.addEventListener('click', () => {
      form.reset();
      result.hidden = true;
    });
  }
</script>

<script data-replies type="application/json" set:html={JSON.stringify({
  verdicts: {
    illegal: { title: S.illegal, body: S.illegalBody },
    misleading: { title: S.misleading, body: S.misleadingBody },
    legal: { title: S.legal, body: S.legalBody },
  },
  replies: S.replies,
  log: S.log,
  dontLog: lang === 'es'
    ? 'No reconoció ese patrón. Descríbelo en tus palabras y llévalo a tu comité o a un organizador.'
    : 'Didn\'t recognize that pattern. Describe it in your own words and bring it to your committee or an organizer.',
})} />
